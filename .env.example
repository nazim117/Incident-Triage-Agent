# Copy this file to .env before running `docker compose up`:
#   cp .env.example .env
#
# .env is already covered by .gitignore (standard Python template includes
# it), so real credentials never get committed. Docker Compose automatically
# reads a file named ".env" in the project root and substitutes these
# values into docker-compose.yml wherever you see ${VAR_NAME}.

POSTGRES_DB=triage
POSTGRES_USER=triage
POSTGRES_PASSWORD=change-me-please

# The webapp connects using the same credentials as above. Duplicated (not
# just reused via YAML anchors) so it's obvious, reading this file top to
# bottom, exactly what the webapp is configured with - useful once you're
# debugging a "webapp can't reach Postgres" incident later.
DB_HOST=db
DB_PORT=5432
DB_NAME=triage
DB_USER=triage
DB_PASSWORD=change-me-please

# Grafana admin password (Phase 2). Defaults to "admin" if unset.
GRAFANA_ADMIN_PASSWORD=change-me-too

# Enables the fault-injection admin endpoints in the webapp (Phase 3):
# /admin/fault/* and /work. Deliberately env-gated and defaulted off in
# spirit of least exposure - a real production service would never ship
# these without strong auth. Defaults to true here because this demo
# stack's whole point is exercising the scripts in injection/; set to
# false (or unset) to confirm those routes disappear entirely.
FAULT_INJECTION_ENABLED=true
